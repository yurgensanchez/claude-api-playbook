# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: nunca subas tu API key al repositorio.

# Obligatorio — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modelo principal de los ejercicios
CLAUDE_MODEL=claude-opus-5

# Modelo barato/rápido para evals masivas y tareas simples
CLAUDE_MODEL_FAST=claude-haiku-4-5

# Modelo antiguo para las lecciones que demuestran parámetros de sampling
# (temperature/top_p ya no se aceptan en Opus 5 / Sonnet 5)
CLAUDE_MODEL_LEGACY=claude-haiku-4-5

# Límite de tokens de salida por defecto
CLAUDE_MAX_TOKENS=4096

# Módulo 06 (RAG) — opcional, solo si usas embeddings de un tercero
VOYAGE_API_KEY=
